<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: transparent;"
  fitToWidth="true"
  stylesheets="@style.css" xmlns="http://javafx.com/javafx/25"
  fx:controller="org.deptrai.auctionsystem.client.controllers.MainController">
  <content>
    <VBox style="-fx-background-color: #f0f2f5;" spacing="0.0">
      <children>

        <HBox alignment="CENTER_LEFT" prefHeight="85.0" spacing="25.0" styleClass="header-bar">
          <children>
            <ComboBox style="-fx-background-radius: 5;" prefHeight="40.0" prefWidth="140.0"
              promptText="Danh mục"/>

            <HBox
              style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 0 10 0 10;"
              alignment="CENTER_LEFT">
              <children>
                <Label text="🔍" textFill="#7f8c8d"/>
                <TextField style="-fx-background-color: transparent;" prefHeight="40.0"
                  prefWidth="350.0"
                  promptText="Tìm kiếm sản phẩm, nghệ sĩ..."/>
              </children>
            </HBox>

            <HBox alignment="CENTER" spacing="15.0">
              <children>
                <Button
                  style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                  managed="false" mnemonicParsing="false"
                  onAction="#handleGoToSellerCenter"
                  text="🏪 Kênh Người Bán"
                  visible="false" fx:id="sellerCenterBtn">
                  <HBox.margin>
                    <Insets right="15.0"/>
                  </HBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="15.0" fx:id="guestBox">
                  <children>
                    <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-login"
                      text="ĐĂNG NHẬP"/>
                    <Button mnemonicParsing="false" onAction="#handleRegister"
                      styleClass="btn-register"
                      text="ĐĂNG KÝ"/>
                  </children>
                </HBox>

                <HBox HBox.hgrow="ALWAYS" alignment="CENTER" managed="false" spacing="20.0"
                  fx:id="userBox">
                  <children>
                    <MenuButton mnemonicParsing="false" styleClass="user-menu-button"
                      text="👤" textFill="WHITE" fx:id="userMenu">
                      <font>
                        <Font size="18.0"/>
                      </font>
                      <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleShowProfile"
                          text="👤 Hồ sơ cá nhân"/>
                        <MenuItem mnemonicParsing="false" onAction="#handleShowBidHistory"
                          text="📜 Lịch sử đặt giá"/>
                        <MenuItem mnemonicParsing="false" onAction="#handleLogout"
                          text="🚪 Đăng xuất"/>
                        <SeparatorMenuItem mnemonicParsing="false"/>
                      </items>
                    </MenuButton>

                    <VBox alignment="CENTER_RIGHT">
                      <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;"
                          text="Tên tk" textFill="WHITE"
                          fx:id="userNameLabel"/>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Ví: $15,000"
                          textFill="#27ae60" fx:id="walletLabel"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>

                <Label styleClass="nav-icon" text="🔔"/>

                <Separator orientation="VERTICAL" prefHeight="30.0"/>
              </children>
            </HBox>

            <Label style="-fx-font-weight: bold; -fx-font-size: 26; -fx-letter-spacing: 1;"
              text="AUCTION SYSTEM" textFill="WHITE"/>

            <Region HBox.hgrow="ALWAYS"/>
          </children>
          <padding>
            <Insets left="40.0" right="40.0"/>
          </padding>
        </HBox>

        <StackPane style="-fx-background-color: #1a252f;" prefHeight="400.0">
          <children>
            <ImageView fitHeight="400.0" fitWidth="1300.0" opacity="0.4" pickOnBounds="true"
              preserveRatio="true"/>
            <VBox alignment="CENTER_LEFT" spacing="20.0">
              <children>
                <Button onAction="#handleOpenAuctionFloor" prefHeight="55.0" prefWidth="220.0"
                  styleClass="btn-register" text="KHÁM PHÁ NGAY"/>
                <Label lineSpacing="10.0"
                  text="Khám phá những bộ sưu tập&#10;độc bản và giá trị nhất." textFill="WHITE">
                  <font>
                    <Font name="System Bold" size="44.0"/>
                  </font>
                </Label>
                <Label style="-fx-font-weight: bold;" text="TRANG THÔNG TIN ĐẤU GIÁ TRỰC TUYẾN"
                  textFill="#27ae60">
                  <font>
                    <Font size="16.0"/>
                  </font>
                </Label>
              </children>
              <padding>
                <Insets left="100.0"/>
              </padding>
            </VBox>
          </children>
        </StackPane>

        <VBox spacing="30.0">
          <children>
            <FlowPane alignment="TOP_LEFT" hgap="40.0" vgap="40.0" fx:id="productsContainer">
            </FlowPane>

            <HBox alignment="BOTTOM_LEFT" spacing="15.0">
              <children>
                <Label style="-fx-font-size: 30; -fx-font-weight: bold;"
                  text="Sản phẩm đang đấu giá" textFill="#2c3e50"/>
                <Label style="-fx-font-size: 18;" text="(15 sản phẩm mới hôm nay)"
                  textFill="#7f8c8d"/>
              </children>
            </HBox>
          </children>
          <padding>
            <Insets bottom="60.0" left="60.0" right="60.0" top="40.0"/>
          </padding>
        </VBox>

      </children>
    </VBox>
  </content>
</ScrollPane>