<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #151226;" stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.deptrai.auctionsystem.client.controllers.LoginController">
    <children>

        <HBox alignment="CENTER" spacing="30.0" maxWidth="650.0" maxHeight="450.0">
            <children>

                <VBox alignment="CENTER" prefWidth="250.0" HBox.hgrow="NEVER">
                    <children>
                        <ImageView fx:id="loginLogoView" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@images/logo.png"/>
                            </image>
                        </ImageView>
                    </children>
                </VBox>

                <VBox alignment="CENTER" maxWidth="350.0" maxHeight="450.0" spacing="25.0"
                      style="-fx-background-color: #1e1936; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 20, 0, 0, 0); -fx-border-color: #2b244d; -fx-border-radius: 15;"
                      HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="🔐 ĐĂNG NHẬP" textFill="#bd93f9"/>

                        <VBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="👤 Tên đăng nhập" textFill="#8c88a8"/>
                                        <TextField fx:id="usernameField" promptText="👤 Nhập username..."
                                                   styleClass="text-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="🔒 Mật khẩu" textFill="#8c88a8"/>
                                        <PasswordField fx:id="passwordField" promptText="🔑 Nhập mật khẩu..."
                                                       styleClass="password-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-success"
                                text="⚡ TRUY CẬP HỆ THỐNG" onAction="#handleLoginAction"/>

                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label text="Chưa có tài khoản?" textFill="#e2e8f0"/>
                                        <Hyperlink text="👉 Đăng ký ngay"
                                                   style="-fx-text-fill: #b026ff; -fx-font-weight: bold;"
                                                   onAction="#handleGoToRegister"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </HBox>

        <Button mnemonicParsing="false" styleClass="btn-back" text="⬅ QUAY LẠI" StackPane.alignment="TOP_LEFT"
                onAction="#handleGoBack">
            <StackPane.margin>
                <Insets left="20.0" top="20.0"/>
            </StackPane.margin>
            <padding>
                <Insets bottom="8.0" left="12.0" right="15.0" top="8.0"/>
            </padding>
        </Button>

    </children>
</StackPane>