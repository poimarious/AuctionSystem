<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.deptrai.auctionsystem.client.controllers.SellerController">
    <children>
        <VBox prefWidth="260.0" spacing="15.0" style="-fx-background-color: white;" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="15.0" /> </padding>
            <children>

                <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ ">
                    <padding>
                        <Insets bottom="8.0" right="15.0" top="8.0" />
                    </padding>
                    <VBox.margin>
                        <Insets bottom="-5.0" /> </VBox.margin>
                </Button>

                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="SELLER CENTER" textFill="#2c3e50" />
                <Separator />

                <Button maxWidth="Infinity" style="-fx-text-fill: #2c3e50;" styleClass="btn-login" text="🏠 Tổng quan" />
                <Button maxWidth="Infinity" onAction="#handleOpenInventory" style="-fx-text-fill: #2c3e50;" styleClass="btn-login" text="📦 Kho hàng của tôi" />
                <Button maxWidth="Infinity" onAction="#handleAddNewProduct" styleClass="btn-bid" text="➕ Đăng sản phẩm mới" />
                <Button maxWidth="Infinity" style="-fx-text-fill: #2c3e50;" styleClass="btn-login" text="📈 Thống kê doanh thu" />

                <Region VBox.vgrow="ALWAYS" />

                <Button maxWidth="Infinity" onAction="#handleShowProfile" style="-fx-background-color: #2c3e50;" styleClass="btn-bid" text="👤 Hồ sơ cá nhân" />

                <Separator />
                <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" styleClass="btn-bid" text="🚪 ĐĂNG XUẤT" />
            </children>
        </VBox>

        <VBox spacing="25.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa;">
            <padding> <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /> </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="Quản lý sản phẩm" textFill="#2c3e50" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField prefHeight="40.0" prefWidth="300.0" promptText="Tìm trong kho..." style="-fx-background-radius: 20;" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <content>
                        <FlowPane hgap="25.0" vgap="25.0">
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>