<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity"
  minHeight="-Infinity"
  minWidth="-Infinity"
  prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css"
  xmlns="http://javafx.com/javafx/25"
  fx:controller="org.deptrai.auctionsystem.client.controllers.MainController">
  <center>
    <ScrollPane style="-fx-background-color: #f0f2f5;" BorderPane.alignment="CENTER"
      fitToWidth="true">
      <content>
        <FlowPane hgap="25.0" vgap="25.0" fx:id="productsContainer">
          <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
          </padding>
        </FlowPane>
      </content>
    </ScrollPane>
  </center>
  <left>
    <VBox
      style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 1 0 0;"
      BorderPane.alignment="CENTER"
      prefWidth="220.0"
      spacing="15.0">
      <children>
        <!--                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAuctionFloor"-->
        <!--                        style="-fx-padding: 10; -fx-font-weight: bold;" text="🔨 SÀN ĐẤU GIÁ"/>-->
        <!--                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleInventory"-->
        <!--                        style="-fx-padding: 10;" text="📦 QUẢN LÝ KHO"/>-->
        <Button style="-fx-padding: 10;" maxWidth="1.7976931348623157E308"
          mnemonicParsing="false" text="📊 BÁO CÁO HỆ THỐNG"/>
      </children>
      <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="30.0"/>
      </padding>
    </VBox>
  </left>
  <top>
    <HBox style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER"
      alignment="CENTER_LEFT"
      prefHeight="70.0"
      spacing="20.0">
      <children>
        <Label text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" textFill="WHITE">
          <font>
            <Font name="System Bold" size="20.0"/>
          </font>
        </Label>
      </children>
      <padding>
        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
      </padding>
    </HBox>
  </top>
</BorderPane>