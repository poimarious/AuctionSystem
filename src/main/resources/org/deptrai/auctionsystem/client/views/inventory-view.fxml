<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
  spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25"
  fx:controller="org.deptrai.auctionsystem.client.controllers.InventoryController">
  <children>
    <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ ">
      <padding>
        <Insets bottom="8.0" left="12.0" right="15.0" top="8.0"/>
      </padding>
    </Button>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
      <children>
        <Button onAction="#handleAddNewProduct" styleClass="btn-bid" text="+ ĐĂNG SẢN PHẨM MỚI"/>
        <Label style="-fx-font-size: 22; -fx-font-weight: bold;" text="KHO HÀNG CỦA TÔI"
          textFill="#2c3e50"/>
        <Region HBox.hgrow="ALWAYS"/>
      </children>
    </HBox>

    <TableView VBox.vgrow="ALWAYS" fx:id="inventoryTable">
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
      <columns>
        <TableColumn prefWidth="100.0" text="ID"/>
        <TableColumn prefWidth="250.0" text="Tên sản phẩm"/>
        <TableColumn prefWidth="150.0" text="Giá khởi điểm"/>
        <TableColumn prefWidth="120.0" text="Trạng thái"/>
        <TableColumn prefWidth="100.0" text="Thao tác"/>
      </columns>
    </TableView>
  </children>
  <padding>
    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
  </padding>
</VBox>