<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #2c3e50;" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.deptrai.auctionsystem.client.controllers.LoginController">
    <children>

        <VBox alignment="CENTER" maxWidth="350.0" maxHeight="450.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 0);">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="ĐĂNG NHẬP" textFill="#2c3e50" />

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Tên đăng nhập" textFill="#7f8c8d" />
                                <TextField fx:id="usernameField" promptText="Nhập username..." styleClass="text-field" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Mật khẩu" textFill="#7f8c8d" />
                                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu..." styleClass="password-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-bid" text="TRUY CẬP HỆ THỐNG" onAction="#handleLoginAction" />

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Chưa có tài khoản?" textFill="#7f8c8d" />
                                <Hyperlink text="Đăng ký ngay" textFill="#27ae60" style="-fx-font-weight: bold;" onAction="#handleGoToRegister" />
                            </children>
                        </HBox>

                        <Hyperlink text="Quên mật khẩu?" textFill="#3498db" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <Button mnemonicParsing="false" styleClass="btn-back" style="-fx-text-fill: white;" text="⬅ " StackPane.alignment="TOP_LEFT" onAction="#handleGoBack">
            <StackPane.margin>
                <Insets left="20.0" top="20.0" />
            </StackPane.margin>
            <padding>
                <Insets bottom="8.0" left="12.0" right="15.0" top="8.0" />
            </padding>
        </Button>

    </children>
</StackPane>