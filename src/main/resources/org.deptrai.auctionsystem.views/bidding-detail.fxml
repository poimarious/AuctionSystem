<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="25.0" style="-fx-background-color: transparent;" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- CỘT TRÁI: THÔNG TIN SẢN PHẨM -->
        <VBox prefWidth="450.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <children>
                <ImageView fx:id="productImage" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="nameLabel" styleClass="product-title" text="Tên sản phẩm" />
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label fx:id="priceLabel" styleClass="price-label" text="GIÁ" />
                        <Label styleClass="timer-label" text="HẾT HẠN TRONG: ....." />
                    </children>
                </HBox>
                <Separator />
                <Label style="-fx-font-weight: bold;" text="Mô tả chi tiết:" />
                <Label fx:id="descLabel" styleClass="product-description" text="Thông tin chi tiết về sản phẩm sẽ được liệt kê tại đây..." wrapText="true" />
            </children>
        </VBox>

        <!-- CỘT PHẢI: LỊCH SỬ & ĐẶT GIÁ -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <children>
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="LỊCH SỬ ĐẶT THẦU" />
                        <TableView fx:id="bidHistoryTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn prefWidth="150.0" text="Thời gian" />
                                <TableColumn prefWidth="120.0" text="Người đặt" />
                                <TableColumn prefWidth="100.0" text="Mức giá" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="bidInput" promptText="Nhập mức giá của bạn..." styleClass="text-field" HBox.hgrow="ALWAYS" />
                        <Button styleClass="btn-bid" text="XÁC NHẬN ĐẶT GIÁ" />
                    </children>
                </HBox>

                <TitledPane animated="false" text="CÀI ĐẶT TỰ ĐỘNG ĐẤU GIÁ (AUTO-BID)">
                    <content>
                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Giới hạn tối đa ($)" />
                                        <TextField fx:id="maxBidInput" prefWidth="150.0" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Bước nhảy giá ($)" />
                                        <TextField fx:id="incrementInput" prefWidth="150.0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </TitledPane>
            </children>
        </VBox>
    </children>
</HBox>
