<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #2c3e50;"
  prefHeight="500.0"
  prefWidth="700.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21"
  fx:controller="org.deptrai.auctionsystem.client.controllers.LoginController">
  <children>

    <Button style="-fx-text-fill: white;" StackPane.alignment="TOP_LEFT" mnemonicParsing="false"
      onAction="#handleGoBack"
      styleClass="btn-back" text="⬅">
      <StackPane.margin>
        <Insets left="20.0" top="20.0"/>
      </StackPane.margin>
      <padding>
        <Insets bottom="8.0" left="12.0" right="15.0" top="8.0"/>
      </padding>
    </Button>

    <VBox
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 0);"
      alignment="CENTER" maxHeight="450.0" maxWidth="350.0"
      spacing="25.0">
      <children>
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
          onAction="#handleLoginAction"
          styleClass="btn-bid" text="TRUY CẬP HỆ THỐNG"/>

        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="ĐĂNG NHẬP"
          textFill="#2c3e50"/>

        <VBox spacing="15.0">
          <children>
            <VBox spacing="5.0">
              <children>
                <Label text="Tên đăng nhập" textFill="#7f8c8d"/>
                <TextField promptText="Nhập username..." styleClass="text-field"
                  fx:id="usernameField"/>
              </children>
            </VBox>
            <VBox spacing="5.0">
              <children>
                <Label text="Mật khẩu" textFill="#7f8c8d"/>
                <PasswordField promptText="Nhập mật khẩu..." styleClass="password-field"
                  fx:id="passwordField"/>
              </children>
            </VBox>
          </children>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
          <children>
            <HBox alignment="CENTER" spacing="5.0">
              <children>
                <Hyperlink style="-fx-font-weight: bold;" onAction="#handleGoToRegister"
                  text="Đăng ký ngay"
                  textFill="#27ae60"/>
                <Label text="Chưa có tài khoản?" textFill="#7f8c8d"/>
              </children>
            </HBox>

            <Hyperlink text="Quên mật khẩu?" textFill="#3498db"/>
          </children>
        </VBox>
      </children>
      <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
      </padding>
    </VBox>

  </children>
</StackPane>