<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:controller="org.deptrai.auctionsystem.client.controllers.AdminController" prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Button mnemonicParsing="false" styleClass="btn-back" text="⬅ ">
            <padding>
                <Insets bottom="8.0" left="12.0" right="15.0" top="8.0" />
            </padding>
        </Button>
        <!-- SIDEBAR ADMIN -->
        <VBox prefWidth="260.0" spacing="15.0" styleClass="header-bar">
            <padding> <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" /> </padding>
            <children>
                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="ADMIN PANEL" textFill="WHITE" />
                <Separator opacity="0.3" />
                <Button maxWidth="Infinity" styleClass="btn-login" text="👥 Quản lý người dùng" />
                <Button maxWidth="Infinity" styleClass="btn-login" text="⚖️ Duyệt đấu giá" />
                <Button maxWidth="Infinity" styleClass="btn-login" text="📜 Nhật ký hệ thống" />
                <Button maxWidth="Infinity" styleClass="btn-login" text="📊 Báo cáo doanh thu" />
                <Region VBox.vgrow="ALWAYS" />
                <Button maxWidth="Infinity" style="-fx-background-color: #e74c3c;" styleClass="btn-bid" text="🚪 Đăng xuất" />
            </children>
        </VBox>

        <!-- NỘI DUNG QUẢN LÝ -->
        <VBox spacing="25.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f0f2f5;">
            <padding> <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /> </padding>
            <children>
                <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="Danh sách phiên đấu giá chờ duyệt" textFill="#2c3e50" />

                <!-- Stats Cards -->
                <HBox spacing="20.0">
                    <children>
                        <VBox prefWidth="250.0" styleClass="item-card" style="-fx-padding: 20;">
                            <children>
                                <Label text="Yêu cầu mới" textFill="#7f8c8d" />
                                <Label text="12" style="-fx-font-size: 32; -fx-font-weight: bold;" textFill="#2c3e50" />
                            </children>
                        </VBox>
                        <VBox prefWidth="250.0" styleClass="item-card" style="-fx-padding: 20;">
                            <children>
                                <Label text="Tổng thành viên" textFill="#7f8c8d" />
                                <Label text="1,042" style="-fx-font-size: 32; -fx-font-weight: bold;" textFill="#27ae60" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Table -->
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="100.0" text="ID Sản phẩm" />
                        <TableColumn prefWidth="250.0" text="Tên sản phẩm" />
                        <TableColumn prefWidth="150.0" text="Người gửi" />
                        <TableColumn prefWidth="150.0" text="Giá khởi điểm" />
                        <TableColumn prefWidth="200.0" text="Thao tác" />
                    </columns>
                    <columnResizePolicy> <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /> </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>
