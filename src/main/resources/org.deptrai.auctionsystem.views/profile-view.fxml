<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.deptrai.auctionsystem.controllers.ProfileController">
    <content>
        <VBox spacing="30.0" style="-fx-padding: 40 60 40 60;">
            <children>

                <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ ">
                    <padding>
                        <Insets bottom="8.0" right="15.0" top="8.0" />
                    </padding>
                    <VBox.margin>
                        <Insets bottom="-15.0" /> </VBox.margin>
                </Button>

                <Label text="HỒ SƠ CÁ NHÂN" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <HBox spacing="30.0">
                    <children>
                        <VBox prefWidth="400.0" spacing="20.0" style="-fx-padding: 25;" styleClass="item-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="20.0">
                                    <children>
                                        <Circle fill="#3498db" radius="35.0" stroke="WHITE" strokeType="INSIDE" />
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label fx:id="profileNameLabel" style="-fx-font-weight: bold; -fx-font-size: 20;" text="Tên tài khoản" />
                                                <Label fx:id="profileRoleLabel" text="Người dùng hệ thống" textFill="#7f8c8d" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Separator />
                                <GridPane vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="120.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Email:" textFill="#7f8c8d" />
                                        <Label fx:id="profileEmailLabel" text="............" GridPane.columnIndex="1" />
                                        <Label text="Ngày tham gia:" textFill="#7f8c8d" GridPane.rowIndex="1" />
                                        <Label text="07/05/2026" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                </GridPane>
                            </children>
                        </VBox>

                        <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 12; -fx-padding: 25;">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="SỐ DƯ VÍ (WALLET)" textFill="#bdc3c7" />
                                <Label fx:id="balanceLabel" text="\$15,000" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                </Label>
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="Infinity" styleClass="btn-bid" text="➕ NẠP TIỀN VÀO VÍ" onAction="#handleTopUpWallet" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="20.0" style="-fx-padding: 30;" styleClass="item-card">
                    <children>
                        <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Cài đặt tài khoản" />
                        <Separator />
                        <VBox maxWidth="500.0" spacing="15.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Mật khẩu hiện tại" />
                                        <PasswordField fx:id="currentPassField" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Mật khẩu mới" />
                                        <PasswordField fx:id="newPassField" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Xác nhận mật khẩu mới" />
                                        <PasswordField fx:id="confirmNewPassField" />
                                    </children>
                                </VBox>
                                <Button style="-fx-text-fill: #2c3e50; -fx-border-color: #2c3e50;" styleClass="btn-login" text="CẬP NHẬT MẬT KHẨU" onAction="#handleUpdatePassword" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox spacing="15.0">
                    <children>
                        <Separator />
                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" styleClass="btn-bid" text="🚪 ĐĂNG XUẤT">
                                    <padding>
                                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                                    </padding>
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
