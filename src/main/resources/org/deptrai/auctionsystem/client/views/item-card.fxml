<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="340.0" prefWidth="280.0" styleClass="item-card"
            style="-fx-background-color: #44475a; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 5);"
            stylesheets="@style.css" xmlns="http://javafx.com/javafx/21"
            fx:controller="org.deptrai.auctionsystem.client.controllers.ItemCardController">

  <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
        AnchorPane.topAnchor="0.0" alignment="TOP_CENTER" spacing="12.0">

    <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <ImageView fitHeight="160.0" fitWidth="220.0" pickOnBounds="true"
               preserveRatio="true" fx:id="itemImageView"/>

    <VBox alignment="CENTER_LEFT" spacing="8.0">
      <padding>
        <Insets left="5.0" right="5.0"/>
      </padding>

      <Label styleClass="product-title" text="Tên sản phẩm" fx:id="nameLabel"
             style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f8f8f2;"/>

      <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="price-label" text="\$0.00" fx:id="priceLabel"
               style="-fx-text-fill: #50fa7b; -fx-font-weight: bold;"/>
        <Label styleClass="timer-label" text="00:00:00" fx:id="timerLabel"
               style="-fx-text-fill: #ff5555; -fx-font-weight: bold;"/>
      </HBox>
    </VBox>

    <Button maxWidth="Infinity" mnemonicParsing="false"
            onAction="#handleBidAction"
            style="-fx-background-color: #bd93f9; -fx-text-fill: #282a36; -fx-font-weight: bold;"
            styleClass="btn-bid" text="XEM CHI TIẾT" fx:id="bidButton"/>
  </VBox>
</AnchorPane>