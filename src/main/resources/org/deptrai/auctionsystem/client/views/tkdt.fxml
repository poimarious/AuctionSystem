<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25.0" style="-fx-background-color: #151226;" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="org.deptrai.auctionsystem.client.controllers.SellerController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <children>
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="📑 Lịch sử Giao dịch" textFill="#bd93f9" />
                        <Label style="-fx-font-size: 14;" text="Quản lý danh sách các đơn hàng và trạng thái thanh toán" textFill="#6272a4" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button prefHeight="40.0" styleClass="btn-success" text="📥 Xuất File Excel (CSV)">
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </Button>
            </children>
        </HBox>

        <VBox spacing="10.0" style="-fx-background-color: #1a162e; -fx-background-radius: 10; -fx-border-color: #2b244d; -fx-border-radius: 10; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Danh sách giao dịch hoàn tất" textFill="WHITE" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Tổng doanh thu: " textFill="#6272a4" />
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="0.00 $" textFill="#50fa7b" />
                    </children>
                </HBox>

                <TableView fx:id="revenueTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" prefWidth="150.0" text="Ngày giao dịch" />
                        <TableColumn fx:id="colOrderId" prefWidth="120.0" text="Mã đơn hàng" />
                        <TableColumn fx:id="colProduct" prefWidth="250.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="colBuyer" prefWidth="150.0" text="Người mua" />
                        <TableColumn fx:id="colFinalPrice" prefWidth="120.0" text="Giá chốt ($)" />
                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Trạng thái ví" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
</VBox>