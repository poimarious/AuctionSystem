<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
  maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
  prefHeight="339.0" prefWidth="408.0" styleClass="item-card"
  stylesheets="@style.css" xmlns="http://javafx.com/javafx/21"
  fx:controller="org.deptrai.auctionsystem.client.controllers.ItemCardController">
  <children>
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
      AnchorPane.topAnchor="0.0" alignment="TOP_CENTER" spacing="12.0">
      <children>
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
          onAction="#handleBidAction"
          styleClass="btn-bid" text="ĐẶT GIÁ NGAY" fx:id="bidButton"/>

        <ImageView fitHeight="160.0" fitWidth="210.0" pickOnBounds="true"
          preserveRatio="true" fx:id="itemImageView"/>

        <VBox alignment="CENTER_LEFT" spacing="5.0">
          <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <children>
                <Label styleClass="price-label" text="\$0.00" fx:id="priceLabel"/>
                <Label styleClass="timer-label" text="00:10:45" fx:id="timerLabel"/>
              </children>
            </HBox>
            <Label styleClass="product-title" text="Tên sản phẩm" fx:id="nameLabel"/>
          </children>
          <padding>
            <Insets left="5.0" right="5.0"/>
          </padding>
        </VBox>
      </children>
      <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
      </padding>
    </VBox>
  </children>
</AnchorPane>