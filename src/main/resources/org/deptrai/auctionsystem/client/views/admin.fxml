<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21"
      fx:controller="org.deptrai.auctionsystem.client.controllers.AdminController">
  <children>

    <VBox prefWidth="260.0" spacing="15.0" styleClass="header-bar">
      <children>
        <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="ADMIN PANEL" textFill="WHITE"/>
        <Separator opacity="0.3"/>

        <Button maxWidth="Infinity" styleClass="btn-login" text="👥 Quản lý người dùng"/>
        <Button maxWidth="Infinity" styleClass="btn-login" text="⚖️ Duyệt đấu giá"/>
        <Button maxWidth="Infinity" styleClass="btn-login" text="📜 Nhật ký hệ thống"/>
        <Button maxWidth="Infinity" styleClass="btn-login" text="📊 Báo cáo doanh thu"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Button style="-fx-background-color: #e74c3c;" maxWidth="Infinity" styleClass="btn-bid" text="🚪 Đăng xuất"/>
      </children>
      <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="30.0"/>
      </padding>
    </VBox>

    <VBox style="-fx-background-color: #f0f2f5;" HBox.hgrow="ALWAYS" spacing="25.0">
      <children>

        <HBox>
          <Button mnemonicParsing="false" styleClass="btn-back" text="⬅ ">
            <padding>
              <Insets bottom="8.0" left="12.0" right="15.0" top="8.0"/>
            </padding>
          </Button>
        </HBox>

        <HBox spacing="20.0">
          <children>
            <VBox style="-fx-padding: 20;" prefWidth="250.0" styleClass="item-card">
              <children>
                <Label text="Yêu cầu mới" textFill="#7f8c8d"/>
                <Label style="-fx-font-size: 32; -fx-font-weight: bold;" text="12" textFill="#2c3e50"/>
              </children>
            </VBox>
            <VBox style="-fx-padding: 20;" prefWidth="250.0" styleClass="item-card">
              <children>
                <Label text="Tổng thành viên" textFill="#7f8c8d"/>
                <Label style="-fx-font-size: 32; -fx-font-weight: bold;" text="1,042" textFill="#27ae60"/>
              </children>
            </VBox>
          </children>
        </HBox>

        <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="Danh sách phiên đấu giá chờ duyệt" textFill="#2c3e50"/>

        <TableView VBox.vgrow="ALWAYS">
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
          <columns>
            <TableColumn prefWidth="100.0" text="ID Sản phẩm"/>
            <TableColumn prefWidth="250.0" text="Tên sản phẩm"/>
            <TableColumn prefWidth="150.0" text="Người gửi"/>
            <TableColumn prefWidth="150.0" text="Giá khởi điểm"/>
            <TableColumn prefWidth="200.0" text="Thao tác"/>
          </columns>
        </TableView>
      </children>
      <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
      </padding>
    </VBox>
  </children>
</HBox>