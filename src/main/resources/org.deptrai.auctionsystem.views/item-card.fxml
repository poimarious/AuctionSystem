<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="org.deptrai.auctionsystem.controllers.ItemCardController"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="339.0" prefWidth="408.0" styleClass="item-card"
            stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <VBox alignment="TOP_CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fx:id="itemImageView" fitHeight="160.0" fitWidth="210.0"
                           pickOnBounds="true" preserveRatio="true" />

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label fx:id="nameLabel" styleClass="product-title" text="Tên sản phẩm" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label fx:id="priceLabel" styleClass="price-label" text="\$0.00" />
                                <Label fx:id="timerLabel" styleClass="timer-label" text="00:10:45" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="5.0" right="5.0" />
                    </padding>
                </VBox>

                <Button fx:id="bidButton" maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false" styleClass="btn-bid" text="ĐẶT GIÁ NGAY" />
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>

        <Button mnemonicParsing="false" styleClass="btn-back" text="⬅"
                AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </Button>

    </children>
</AnchorPane>