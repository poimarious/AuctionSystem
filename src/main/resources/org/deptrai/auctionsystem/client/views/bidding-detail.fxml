<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="1100.0" spacing="20.0" style="-fx-background-color: #151226;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.deptrai.auctionsystem.client.controllers.BiddingDetailController">

    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ QUAY LẠI">
            <padding>
                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0"/>
            </padding>
        </Button>
        <Label style="-fx-font-weight: bold; -fx-font-size: 20;" text="🔨 CHI TIẾT PHIÊN ĐẤU GIÁ" textFill="#bd93f9"/>
    </HBox>

    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <VBox maxWidth="400.0" prefWidth="400.0" spacing="15.0"
              style="-fx-background-color: #1e1936; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 4); -fx-border-color: #2b244d; -fx-border-radius: 15; -fx-border-width: 1.5;">
            <StackPane style="-fx-background-color: #151226; -fx-background-radius: 10;">
                <ImageView fx:id="productImageView" fitHeight="260.0" fitWidth="360.0" pickOnBounds="true"
                           preserveRatio="true"/>
            </StackPane>

            <Label fx:id="nameLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ffffff;"
                   styleClass="product-title" text="Tên sản phẩm" wrapText="true"/>

            <HBox spacing="20.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13; -fx-font-weight: bold;" text="GIÁ HIỆN TẠI"
                           textFill="#8c88a8"/>
                    <Label fx:id="currentPriceLabel"
                           style="-fx-font-size: 22; -fx-text-fill: #39ff14; -fx-font-weight: bold;"
                           styleClass="price-label" text="\$0.00"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="5.0"
                      style="-fx-background-color: #151226; -fx-border-color: #ff003c; -fx-padding: 8 15; -fx-background-radius: 8; -fx-border-radius: 8;">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="⏳ CÒN LẠI"
                           textFill="#ff003c"/>
                    <Label fx:id="expiryTimerLabel"
                           style="-fx-font-size: 16; -fx-text-fill: #ff003c; -fx-font-weight: bold;"
                           styleClass="timer-label" text="00:00:00"/>
                </VBox>
            </HBox>

            <Separator opacity="0.3"/>

            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #00f3ff;"
                   text="📝 Mô tả sản phẩm:"/>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                        VBox.vgrow="ALWAYS">
                <Label fx:id="descriptionLabel" style="-fx-font-size: 14; -fx-text-fill: #e2e8f0;" text="..."
                       wrapText="true"/>
            </ScrollPane>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <VBox spacing="10.0"
                  style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 2); -fx-border-color: #2b244d; -fx-border-radius: 10; -fx-border-width: 1.5;"
                  styleClass="item-card" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #bd93f9;"
                       text="📜 LỊCH SỬ &amp; BIẾN ĐỘNG GIÁ TRÊN SÀN"/>

                <TableView fx:id="bidHistoryTable" prefHeight="220.0" VBox.vgrow="SOMETIMES">
                    <columns>
                        <TableColumn fx:id="timeColumn" prefWidth="130.0" text="Thời gian"/>
                        <TableColumn fx:id="bidderColumn" prefWidth="140.0" text="Người đặt"/>
                        <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Mức giá ($)"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <LineChart fx:id="bidChart" animated="false" legendVisible="false" prefHeight="200.0"
                           title="Biểu đồ Biến động Giá" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Thời gian"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Mức giá ($)"/>
                    </yAxis>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="15.0" top="5.0"/>
                    </padding>
                </LineChart>
            </VBox>

            <HBox minHeight="130.0" spacing="15.0">
                <VBox maxWidth="Infinity" spacing="10.0"
                      style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #39ff14; -fx-border-radius: 10; -fx-border-width: 2;"
                      styleClass="item-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #39ff14;"
                               text="⚡ CHẾ ĐỘ ĐẶT GIÁ"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <RadioButton fx:id="radioQuick" selected="true"
                                     style="-fx-font-size: 11; -fx-text-fill: #e2e8f0;" text="Nhanh">
                            <toggleGroup>
                                <ToggleGroup fx:id="bidModeGroup"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radioCustom" style="-fx-font-size: 11; -fx-text-fill: #e2e8f0;"
                                     text="Cụ thể" toggleGroup="$bidModeGroup"/>
                    </HBox>

                    <StackPane VBox.vgrow="ALWAYS">
                        <HBox fx:id="quickBidBox" alignment="CENTER" spacing="10">
                            <Button onAction="#handleDecreaseBid"
                                    style="-fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #2b244d; -fx-text-fill: #ff003c; -fx-pref-width: 40;"
                                    text="-"/>
                            <Label fx:id="quickBidLabel" alignment="CENTER" maxWidth="Infinity"
                                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #39ff14;"
                                   text="\$0.00" HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleIncreaseBid"
                                    style="-fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #2b244d; -fx-text-fill: #39ff14; -fx-pref-width: 40;"
                                    text="+"/>
                        </HBox>

                        <TextField fx:id="bidAmountField" prefHeight="38.0" promptText="Nhập số tiền ($)..."
                                   style="-fx-background-color: #151226; -fx-text-fill: #39ff14; -fx-prompt-text-fill: #8c88a8; -fx-border-color: #2b244d; -fx-border-radius: 5;"
                                   visible="false"/>
                    </StackPane>

                    <Button defaultButton="true" maxWidth="Infinity" onAction="#handlePlaceBid"
                            prefHeight="40.0"
                            style="-fx-background-color: #39ff14; -fx-text-fill: #151226; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;"
                            styleClass="btn-bid" text="✅ XÁC NHẬN ĐẶT GIÁ" fx:id="btnPlaceBid"/>
                </VBox>

                <VBox maxWidth="Infinity" spacing="10.0"
                      style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #00f3ff; -fx-border-radius: 10; -fx-border-width: 2;"
                      styleClass="item-card" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #00f3ff;"
                           text="🤖 TỰ ĐỘNG ĐẤU GIÁ (AUTO-BID)"/>
                    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <TextField fx:id="maxBidField" prefHeight="38.0" promptText="🚀 Giới hạn Max ($)"
                                   styleClass="text-field" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="incrementField" prefHeight="38.0" promptText="📈 Bước nhảy ($)"
                                   styleClass="text-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button fx:id="btnAutoBid" maxWidth="Infinity" onAction="#handleActivateAutoBid"
                            prefHeight="40.0" styleClass="btn-primary" text="⚙️ KÍCH HOẠT AUTO-BID"/>
                </VBox>

            </HBox>

        </VBox>
    </HBox>
</VBox>
