<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox prefHeight="750.0" prefWidth="1100.0" spacing="20.0" style="-fx-background-color: #151226;"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.deptrai.auctionsystem.client.controllers.BiddingDetailController">

    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ QUAY LẠI">
                <padding>
                    <Insets bottom="8.0" left="15.0" right="15.0" top="8.0"/>
                </padding>
            </Button>
            <Label text="🔨 CHI TIẾT PHIÊN ĐẤU GIÁ" textFill="#bd93f9"
                   style="-fx-font-weight: bold; -fx-font-size: 20;"/>
        </children>
    </HBox>

    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <children>
            <VBox maxWidth="400.0" prefWidth="400.0" spacing="15.0"
                  style="-fx-background-color: #1e1936; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 4); -fx-border-color: #2b244d; -fx-border-radius: 15; -fx-border-width: 1.5;">
                <children>
                    <StackPane style="-fx-background-color: #151226; -fx-background-radius: 10;">
                        <children>
                            <ImageView fx:id="productImageView" fitHeight="260.0" fitWidth="360.0" pickOnBounds="true"
                                       preserveRatio="true"/>
                        </children>
                    </StackPane>

                    <Label fx:id="nameLabel" styleClass="product-title" text="Tên sản phẩm" wrapText="true"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

                    <HBox spacing="20.0">
                        <children>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="GIÁ HIỆN TẠI" textFill="#8c88a8"
                                           style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                                    <Label fx:id="currentPriceLabel" styleClass="price-label" text="\$0.00"
                                           style="-fx-font-size: 22; -fx-text-fill: #39ff14; -fx-font-weight: bold;"/>
                                </children>
                            </VBox>
                            <VBox spacing="5.0" alignment="CENTER_RIGHT"
                                  style="-fx-background-color: #151226; -fx-border-color: #ff003c; -fx-padding: 8 15; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <children>
                                    <Label text="⏳ CÒN LẠI" textFill="#ff003c"
                                           style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                                    <Label fx:id="expiryTimerLabel" styleClass="timer-label" text="00:00:00"
                                           style="-fx-font-size: 16; -fx-text-fill: #ff003c; -fx-font-weight: bold;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <Separator opacity="0.3"/>

                    <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #00f3ff;"
                           text="📝 Mô tả sản phẩm:"/>
                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent;"
                                VBox.vgrow="ALWAYS">
                        <content>
                            <Label fx:id="descriptionLabel" text="..." wrapText="true"
                                   style="-fx-font-size: 14; -fx-text-fill: #e2e8f0;"/>
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                <children>

                    <VBox spacing="10.0" VBox.vgrow="ALWAYS" styleClass="item-card"
                          style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 2); -fx-border-color: #2b244d; -fx-border-radius: 10; -fx-border-width: 1.5;">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #bd93f9;"
                                   text="📜 LỊCH SỬ &amp; BIẾN ĐỘNG GIÁ TRÊN SÀN"/>

                            <TableView fx:id="bidHistoryTable" prefHeight="220.0" VBox.vgrow="SOMETIMES">
                                <columns>
                                    <TableColumn fx:id="timeColumn" prefWidth="130.0" text="Thời gian"/>
                                    <TableColumn fx:id="bidderColumn" prefWidth="140.0" text="Người đặt"/>
                                    <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Mức giá ($)"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                            <LineChart fx:id="bidChart" title="Biểu đồ Biến động Giá" animated="false"
                                       legendVisible="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                <xAxis>
                                    <CategoryAxis label="Thời gian"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Mức giá ($)"/>
                                </yAxis>
                                <padding>
                                    <Insets bottom="5.0" left="5.0" right="15.0" top="5.0"/>
                                </padding>
                            </LineChart>
                        </children>
                    </VBox>

                    <HBox spacing="15.0" minHeight="130.0">
                        <children>

                            <VBox spacing="10.0" styleClass="item-card"
                                  style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #39ff14; -fx-border-radius: 10; -fx-border-width: 2;"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <children>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="⚡ CHẾ ĐỘ ĐẶT GIÁ"
                                               style="-fx-font-weight: bold; -fx-text-fill: #39ff14;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <RadioButton fx:id="radioQuick" text="Nhanh" selected="true"
                                                     style="-fx-font-size: 11; -fx-text-fill: #e2e8f0;">
                                            <toggleGroup>
                                                <ToggleGroup fx:id="bidModeGroup"/>
                                            </toggleGroup>
                                        </RadioButton>
                                        <RadioButton fx:id="radioCustom" text="Cụ thể" toggleGroup="$bidModeGroup"
                                                     style="-fx-font-size: 11; -fx-text-fill: #e2e8f0;"/>
                                    </HBox>

                                    <StackPane VBox.vgrow="ALWAYS">
                                        <HBox fx:id="quickBidBox" spacing="10" alignment="CENTER">
                                            <Button text="-" onAction="#handleDecreaseBid"
                                                    style="-fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #2b244d; -fx-text-fill: #ff003c; -fx-pref-width: 40;"/>
                                            <Label fx:id="quickBidLabel" text="\$0.00"
                                                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #39ff14;"
                                                   HBox.hgrow="ALWAYS" alignment="CENTER" maxWidth="Infinity"/>
                                            <Button text="+" onAction="#handleIncreaseBid"
                                                    style="-fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #2b244d; -fx-text-fill: #39ff14; -fx-pref-width: 40;"/>
                                        </HBox>

                                        <TextField fx:id="bidAmountField" promptText="Nhập số tiền ($)..."
                                                   style="-fx-background-color: #151226; -fx-text-fill: #39ff14; -fx-prompt-text-fill: #8c88a8; -fx-border-color: #2b244d; -fx-border-radius: 5;"
                                                   prefHeight="38.0" visible="false"/>
                                    </StackPane>

                                    <Button onAction="#handlePlaceBid" styleClass="btn-bid" text="✅ XÁC NHẬN ĐẶT GIÁ"
                                            prefHeight="40.0" maxWidth="Infinity"
                                            style="-fx-background-color: #39ff14; -fx-text-fill: #151226; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;"/>
                                </children>
                            </VBox>

                            <VBox spacing="10.0" styleClass="item-card"
                                  style="-fx-padding: 15; -fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #00f3ff; -fx-border-radius: 10; -fx-border-width: 2;"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <children>
                                    <Label text="🤖 TỰ ĐỘNG ĐẤU GIÁ (AUTO-BID)"
                                           style="-fx-font-weight: bold; -fx-text-fill: #00f3ff;"/>
                                    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                                        <children>
                                            <TextField fx:id="maxBidField" promptText="🚀 Giới hạn Max ($)"
                                                       prefHeight="38.0" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                                            <TextField fx:id="incrementField" promptText="📈 Bước nhảy ($)"
                                                       prefHeight="38.0" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                                        </children>
                                    </HBox>
                                    <Button fx:id="btnAutoBid" onAction="#handleActivateAutoBid" maxWidth="Infinity"
                                            styleClass="btn-primary" text="⚙️ KÍCH HOẠT AUTO-BID" prefHeight="40.0"/>
                                </children>
                            </VBox>

                        </children>
                    </HBox>

                </children>
            </VBox>
        </children>
    </HBox>
</VBox>