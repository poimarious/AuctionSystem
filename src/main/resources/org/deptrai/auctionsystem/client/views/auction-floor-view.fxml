<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: transparent;"
      prefHeight="600.0" prefWidth="800.0"
      spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25"
      fx:controller="org.deptrai.auctionsystem.client.controllers.AuctionFloorController">
  <children>
    <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ ">
      <padding>
        <Insets bottom="8.0" left="12.0" right="15.0" top="8.0"/>
      </padding>
    </Button>

    <HBox
            style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 15; -fx-background-radius: 10;"
            alignment="CENTER_LEFT"
            spacing="15.0">
      <VBox.margin>
        <Insets left="20.0" right="20.0" top="10.0"/>
      </VBox.margin>
      <children>
        <ComboBox prefWidth="150.0" promptText="Tất cả danh mục" fx:id="categoryCombo"/>
        <ComboBox prefWidth="150.0" promptText="Trạng thái" fx:id="statusCombo"/>
        <TextField style="-fx-background-radius: 20;" prefWidth="350.0"
                   promptText="Tìm tên sản phẩm, nghệ sĩ, hãng xe..." fx:id="searchField"/>
      </children>
      <padding>
        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
      </padding>
    </HBox>

    <ScrollPane style="-fx-background-color: transparent; -fx-background: transparent;"
                fitToWidth="true" VBox.vgrow="ALWAYS">
      <content>
        <FlowPane hgap="25.0" stylesheets="@style.css" vgap="25.0" fx:id="productsContainer">
          <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
          </padding>
        </FlowPane>
      </content>
    </ScrollPane>
  </children>
</VBox>