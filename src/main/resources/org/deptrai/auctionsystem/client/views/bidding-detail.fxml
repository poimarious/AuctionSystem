<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.LineChart?>

<VBox prefHeight="750.0" prefWidth="1100.0" spacing="20.0" style="-fx-background-color: #f4f7f6;"
  stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="org.deptrai.auctionsystem.client.controllers.BiddingDetailController">

  <padding>
    <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
  </padding>

  <HBox alignment="CENTER_LEFT" spacing="15.0">
    <children>
      <Button mnemonicParsing="false" onAction="#handleGoBack" styleClass="btn-back" text="⬅ QUAY LẠI">
        <padding>
          <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
        </padding>
      </Button>
      <Label text="CHI TIẾT ĐẤU GIÁ" textFill="#2c3e50" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
    </children>
  </HBox>

  <HBox spacing="25.0" VBox.vgrow="ALWAYS">
    <children>
      <VBox maxWidth="400.0" prefWidth="400.0" spacing="15.0"
        style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
        <children>
          <StackPane style="-fx-background-color: #f9f9f9; -fx-background-radius: 10;">
            <children>
              <ImageView fx:id="productImageView" fitHeight="260.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="true" />
            </children>
          </StackPane>

          <Label fx:id="nameLabel" styleClass="product-title" text="Tên sản phẩm" wrapText="true" style="-fx-font-size: 18; -fx-font-weight: bold;" />

          <HBox spacing="20.0">
            <children>
              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <children>
                  <Label text="GIÁ HIỆN TẠI" textFill="#7f8c8d" style="-fx-font-size: 13;"/>
                  <Label fx:id="currentPriceLabel" styleClass="price-label" text="\$0.00" style="-fx-font-size: 22; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" />
                </children>
              </VBox>
              <VBox spacing="5.0" alignment="CENTER_RIGHT" style="-fx-background-color: #fff2f2; -fx-padding: 8 15; -fx-background-radius: 8;">
                <children>
                  <Label text="THỜI GIAN CÒN LẠI" textFill="#e74c3c" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                  <Label fx:id="expiryTimerLabel" styleClass="timer-label" text="00:00:00" style="-fx-font-size: 16; -fx-text-fill: #c0392b; -fx-font-weight: bold;" />
                </children>
              </VBox>
            </children>
          </HBox>

          <Separator />

          <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Mô tả sản phẩm:" />
          <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <Label fx:id="descriptionLabel" text="..." wrapText="true" style="-fx-font-size: 14; -fx-text-fill: #34495e;" />
            </content>
          </ScrollPane>
        </children>
      </VBox>

      <VBox spacing="15.0" HBox.hgrow="ALWAYS">
        <children>

          <VBox spacing="10.0" VBox.vgrow="ALWAYS" styleClass="item-card" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <children>
              <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="📜 LỊCH SỬ &amp; BIẾN ĐỘNG GIÁ" />

              <TableView fx:id="bidHistoryTable" prefHeight="220.0" VBox.vgrow="SOMETIMES">
                <columns>
                  <TableColumn fx:id="timeColumn" prefWidth="130.0" text="Thời gian" />
                  <TableColumn fx:id="bidderColumn" prefWidth="140.0" text="Người đặt" />
                  <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Mức giá ($)" />
                </columns>
                <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
              </TableView>

              <LineChart fx:id="bidChart" title="Biểu đồ Biến động Giá" animated="false" legendVisible="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
                <xAxis>
                  <CategoryAxis label="Thời gian" />
                </xAxis>
                <yAxis>
                  <NumberAxis label="Mức giá ($)" />
                </yAxis>
                <padding>
                  <Insets bottom="5.0" left="5.0" right="15.0" top="5.0" />
                </padding>
              </LineChart>
            </children>
          </VBox>

          <HBox spacing="15.0" minHeight="130.0">
            <children>

              <VBox spacing="10.0" styleClass="item-card" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #2ecc71; -fx-border-radius: 10; -fx-border-width: 2;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <children>
                  <Label text="ĐẶT GIÁ THỦ CÔNG" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                  <TextField fx:id="bidAmountField" promptText="Nhập số tiền ($)..." styleClass="text-field" prefHeight="38.0" VBox.vgrow="ALWAYS"/>
                  <Button onAction="#handlePlaceBid" styleClass="btn-bid" text="XÁC NHẬN ĐẶT GIÁ" prefHeight="40.0" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                </children>
              </VBox>

              <VBox spacing="10.0" styleClass="item-card" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #3498db; -fx-border-radius: 10; -fx-border-width: 2;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <children>
                  <Label text="TỰ ĐỘNG ĐẤU GIÁ (AUTO-BID)" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                      <TextField fx:id="maxBidField" promptText="Giới hạn Max ($)" prefHeight="38.0" HBox.hgrow="ALWAYS"/>
                      <TextField fx:id="incrementField" promptText="Bước nhảy ($)" prefHeight="38.0" HBox.hgrow="ALWAYS"/>
                    </children>
                  </HBox>
                  <Button maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" text="KÍCH HOẠT AUTO-BID" prefHeight="40.0"/>
                </children>
              </VBox>

            </children>
          </HBox>

        </children>
      </VBox>
    </children>
  </HBox>
</VBox>