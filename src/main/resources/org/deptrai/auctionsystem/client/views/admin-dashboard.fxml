<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #151226;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.deptrai.auctionsystem.client.controllers.AdminDashboardController">

  <left>
    <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #1e1936; -fx-border-color: #2b244d; -fx-border-width: 0 2 0 0;">
      <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
      </padding>
      <children>
        <Label text="⚡ ADMIN PANEL" textFill="#00f3ff" style="-fx-font-weight: bold; -fx-font-size: 22;">
          <VBox.margin>
            <Insets bottom="30.0" />
          </VBox.margin>
        </Label>

        <Label text="QUẢN LÝ HỆ THỐNG" textFill="#8c88a8" style="-fx-font-size: 12; -fx-font-weight: bold;">
          <VBox.margin>
            <Insets bottom="5.0" />
          </VBox.margin>
        </Label>

        <Button fx:id="btnNavAuctions" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAuctionsPane" style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14; -fx-cursor: hand;" text="📦 Quản lý Phiên Đấu giá" />
        <Button fx:id="btnNavUsers" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showUsersPane" style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14; -fx-cursor: hand;" text="👥 Quản lý Người dùng" />

        <Region VBox.vgrow="ALWAYS" />

        <Separator opacity="0.3" />
        <Label fx:id="lblAdminInfo" text="Admin: ..." textFill="#bd93f9" style="-fx-font-weight: bold;">
          <VBox.margin>
            <Insets top="10.0" bottom="10.0"/>
          </VBox.margin>
        </Label>
        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #ff003c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🚪 ĐĂNG XUẤT" />
      </children>
    </VBox>
  </left>

  <center>
    <StackPane style="-fx-padding: 30;">
      <children>

        <VBox fx:id="paneAuctions" spacing="20.0" style="-fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #2b244d; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 20;">
          <children>
            <HBox alignment="CENTER_LEFT">
              <Label text="📦 QUẢN LÝ PHIÊN ĐẤU GIÁ" textFill="#bd93f9" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
              <Region HBox.hgrow="ALWAYS" />
              <Button onAction="#loadAllAuctions" text="🔄 Làm mới" style="-fx-background-color: #2b244d; -fx-text-fill: #00f3ff; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS" style="-fx-base: #151226; -fx-control-inner-background: #151226; -fx-table-cell-border-color: #2b244d; -fx-text-background-color: #e2e8f0;">
              <columns>
                <TableColumn fx:id="colAuctionId" prefWidth="250.0" text="Mã Phiên (ID)" />
                <TableColumn fx:id="colItemName" prefWidth="250.0" text="Tên Sản phẩm" />
                <TableColumn fx:id="colPrice" prefWidth="150.0" text="Giá Hiện tại" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
                <TableColumn fx:id="colAuctionAction" prefWidth="100.0" text="Thao tác" />
              </columns>
              <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
            </TableView>
          </children>
        </VBox>

        <VBox fx:id="paneUsers" spacing="20.0" visible="false" style="-fx-background-color: #1e1936; -fx-background-radius: 10; -fx-border-color: #2b244d; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 20;">
          <children>
            <HBox alignment="CENTER_LEFT">
              <Label text="👥 QUẢN LÝ NGƯỜI DÙNG" textFill="#00f3ff" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
              <Region HBox.hgrow="ALWAYS" />
              <Button onAction="#loadAllUsers" text="🔄 Làm mới" style="-fx-background-color: #2b244d; -fx-text-fill: #bd93f9; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS" style="-fx-base: #151226; -fx-control-inner-background: #151226; -fx-table-cell-border-color: #2b244d; -fx-text-background-color: #e2e8f0;">
              <columns>
                <TableColumn fx:id="colUserId" prefWidth="250.0" text="Mã Người dùng (ID)" />
                <TableColumn fx:id="colUsername" prefWidth="180.0" text="Tên đăng nhập" />
                <TableColumn fx:id="colRole" prefWidth="120.0" text="Vai trò" />
                <TableColumn fx:id="colUserStatus" prefWidth="150.0" text="Trạng thái" />
                <TableColumn fx:id="colUserAction" prefWidth="120.0" text="Thao tác" />
              </columns>
              <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
            </TableView>
          </children>
        </VBox>

      </children>
    </StackPane>
  </center>
</BorderPane>